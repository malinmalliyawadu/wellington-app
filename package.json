{
  "name": "wellington-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:schema": "supabase db execute -f supabase/schema.sql",
    "db:seed": "supabase db execute -f supabase/seed.sql",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:login": "supabase login",
    "db:link": "supabase link --project-ref octeacvgbszdwzluxaef",
    "db:create-users": "dotenv -- node supabase/create-seed-users.mjs",
    "db:schema:remote": "dotenv -- node supabase/run-sql.mjs supabase/schema.sql",
    "db:seed:remote": "dotenv -- node supabase/run-sql.mjs supabase/seed.sql",
    "db:reset:remote": "dotenv -- node supabase/run-sql.mjs supabase/reset-remote.sql",
    "db:setup:remote": "npm run db:reset:remote && npm run db:schema:remote && npm run db:create-users && npm run db:seed:remote"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/drawer": "^7.5.0",
    "@supabase/supabase-js": "^2.95.3",
    "expo": "^54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-calendar": "~15.0.8",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.15",
    "expo-web-browser": "~15.0.10",
    "jsonwebtoken": "^9.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "dotenv-cli": "^11.0.0",
    "pg": "^8.18.0",
    "supabase": "^2.76.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
