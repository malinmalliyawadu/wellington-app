# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-1-region.pooler.supabase.com:6543/postgres

# Google Places API
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-places-api-key

# App URLs
EXPO_PUBLIC_WELLY_WEBSITE_URL=https://wellyapp.nz

# Instagram
EXPO_PUBLIC_INSTAGRAM_APP_ID=your-instagram-app-id
